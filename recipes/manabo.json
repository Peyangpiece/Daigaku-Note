{
  "id": "manabo",
  "name": "manabo",
  "version": "2026.10.2",
  "verified": false,
  "note": "SPEC §18.1 の構造を元に書いた。回の題名は押す要素の文字、なければその行の 1 つ前の行。お知らせは #div-class-news に AJAX で入り [+] で開くので container と auto を使う。実物の manabo で確かめるまで verified は false。確かめたら true にして version を上げる",
  "detect": {
    "urlPatterns": ["manabo\\."],
    "htmlMarkers": ["div-class-directories", "manabo"]
  },
  "login": {
    "loggedIn": {"selector": "#button-logout, a[href*='logout']"},
    "form": null
  },
  "courses": {
    "url": "{base}/",
    "items": "a[href*='/class/']",
    "name": "@text",
    "link": "@href",
    "lmsId": "@href:/\\/class\\/(\\d+)/",
    "weekday": "@text:/[（(]([月火水木金土日])曜/",
    "period": "@text:/([1-7])限/"
  },
  "rounds": {
    "url": "{course.url}",
    "items": "#div-class-directories .a-open-contents",
    "title": "@text || ^tr<@text",
    "link": "@directory_id",
    "round": "@text:/第\\s*(\\d{1,2})\\s*回|(\\d{1,2})\\s*回目/"
  },
  "files": {
    "url": "{course.url}",
    "openBeforeRead": "#div-class-directories .a-open-contents[directory_id='{round.lmsRef}']",
    "items": "#div-class-contents a[href*='/file/']",
    "name": "@text",
    "link": "@href"
  },
  "notices": {
    "url": "{course.url}",
    "container": "#div-class-news",
    "openBeforeRead": "auto",
    "items": "auto",
    "files": "a[href*='/file/']",
    "title": "@innertext:/^([^\\n]+)/",
    "round": "@innertext:/【\\s*第\\s*(\\d{1,2})\\s*回|第\\s*(\\d{1,2})\\s*回/"
  },
  "waits": {"afterClick": 800, "pageLoad": "domcontentloaded"},
  "universities": {}
}
