{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "大学ノート 画面操作型レシピ",
  "type": "object",
  "required": ["id", "name", "version", "detect", "login", "courses", "rounds", "files"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]{2,32}$"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,3}$"},
    "verified": {"type": "boolean"},
    "note": {"type": "string"},
    "allowedHosts": {"type": "array", "items": {"type": "string"}},
    "detect": {
      "type": "object",
      "properties": {
        "urlPatterns": {"type": "array", "items": {"type": "string"}},
        "htmlMarkers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "login": {
      "type": "object",
      "required": ["loggedIn"],
      "properties": {
        "loggedIn": {"type": "object", "required": ["selector"], "properties": {"selector": {"type": "string"}}},
        "form": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["user", "password", "submit"],
              "properties": {"user": {"type": "string"}, "password": {"type": "string"}, "submit": {"type": "string"}}
            }
          ]
        }
      }
    },
    "courses": {"$ref": "#/$defs/listing"},
    "rounds": {"$ref": "#/$defs/listing"},
    "files": {"$ref": "#/$defs/listing"},
    "notices": {"$ref": "#/$defs/listing"},
    "waits": {"type": "object", "properties": {"afterClick": {"type": "integer"}, "pageLoad": {"type": "string"}}},
    "universities": {"type": "object", "additionalProperties": {"type": "object"}}
  },
  "$defs": {
    "listing": {
      "type": "object",
      "required": ["url", "items"],
      "properties": {
        "url": {"type": "string"},
        "items": {
          "type": "string",
          "description": "項目のセレクタ。'auto' なら container の中の、開いた見出しごとの項目（container が要る）"
        },
        "openBeforeRead": {
          "type": ["string", "null"],
          "description": "読む前に押す要素。'auto' なら container の中の折りたたみをすべて開く（container が要る）"
        },
        "container": {"type": "string", "description": "AJAX で後から入る欄。中身が入るまで待つ。auto の範囲"}
      },
      "additionalProperties": {"type": "string"}
    }
  }
}
